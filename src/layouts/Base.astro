---
import { getImage, Image } from "astro:assets";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import isotipo from "../assets/brand/isotipo.png";
import logo from "../assets/brand/logo.png";
import logoBlanco from "../assets/brand/logo-blanco.png";
import ogDefault from "../assets/img/pa-despues.png";
import { SITE, anios, waLink } from "../site";

interface Props {
  title: string;
  description: string;
  /** Imagen para compartir en redes; por defecto una vivienda ampliada. */
  ogImage?: ImageMetadata;
  /** Datos estructurados propios de la página (se suman a los de la empresa). */
  schema?: Record<string, unknown>[];
  breadcrumb?: { name: string; path: string }[];
  noindex?: boolean;
}

const { title, description, ogImage = ogDefault, schema = [], breadcrumb, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", SITE.url).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 82 });
const ogUrl = new URL(og.src, SITE.url).href;
const favicon = await getImage({ src: isotipo, width: 64, format: "png" });
const appleIcon = await getImage({ src: isotipo, width: 180, format: "png", background: "#ffffff" });
const logoUrl = new URL((await getImage({ src: logo, width: 600, format: "png" })).src, SITE.url).href;

const sameAs = Object.values(SITE.redes).filter(Boolean);
const empresa = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "@id": `${SITE.url}/#empresa`,
  name: SITE.nombre,
  alternateName: `${SITE.nombre} ${SITE.bajada}`,
  description: `Empresa constructora de ${SITE.ciudad}, Argentina, especializada en ampliaciones de viviendas, viviendas y módulos habitacionales en Steel Frame. ${anios} años de trayectoria y más de ${SITE.obrasTerminadas} obras terminadas.`,
  url: SITE.url,
  logo: logoUrl,
  image: ogUrl,
  telephone: SITE.telefonoE164,
  ...(SITE.email ? { email: SITE.email } : {}),
  foundingDate: String(SITE.fundacion),
  address: { "@type": "PostalAddress", addressLocality: SITE.ciudad, addressRegion: SITE.provincia, addressCountry: SITE.pais },
  areaServed: [
    ...SITE.localidades.map((name) => ({ "@type": "City", name })),
    { "@type": "AdministrativeArea", name: "Provincia de Córdoba" },
  ],
  knowsAbout: ["Steel Frame", "Construcción en seco", "Ampliaciones de viviendas", "Módulos habitacionales", "Construcción llave en mano"],
  slogan: "Tu proyecto, en buenas manos.",
  contactPoint: {
    "@type": "ContactPoint",
    telephone: SITE.telefonoE164,
    contactType: "customer service",
    areaServed: "AR",
    availableLanguage: "es",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios de construcción",
    itemListElement: [
      ["Ampliaciones de viviendas en Steel Frame", "/ampliaciones"],
      ["Módulos habitacionales H1, H2 y H3", "/modulos"],
      ["Covacha: módulo habitable compacto", "/covacha"],
    ].map(([name, path]) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name, url: `${SITE.url}${path}` } })),
  },
  ...(sameAs.length ? { sameAs } : {}),
};

const migas = breadcrumb && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [{ name: "Inicio", path: "/" }, ...breadcrumb].map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.name,
    item: new URL(b.path, SITE.url).href,
  })),
};

const ldJson = [empresa, ...(migas ? [migas] : []), ...schema];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/ampliaciones", label: "Ampliaciones" },
  { href: "/modulos", label: "Módulos" },
  { href: "/covacha", label: "Covacha" },
  { href: "/#como-trabajamos", label: "Cómo trabajamos" },
  { href: "/#preguntas", label: "Preguntas" },
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#151413" />
    <meta name="geo.region" content="AR-X" />
    <meta name="geo.placename" content={SITE.ciudad} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={appleIcon.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Resumen para asistentes de IA" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={`${SITE.nombre} ${SITE.bajada}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {ldJson.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label={`${SITE.nombre}, ir al inicio`}>
          <Image src={logo} alt={`${SITE.nombre} ${SITE.bajada}`} width={118} loading="eager" />
        </a>
        <nav aria-label="Principal" class="nav-desktop">
          {nav.map((n) => <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>)}
        </nav>
        <div class="bar-cta">
          <a class="tel" href={`tel:${SITE.telefonoE164}`}><Icon name="phone" size={18} /> {SITE.telefono}</a>
          <a class="btn btn-primary btn-sm" href={waLink()} target="_blank" rel="noopener">Pedí presupuesto</a>
          <details class="nav-mobile">
            <summary aria-label="Abrir menú"><Icon name="menu" /></summary>
            <nav aria-label="Menú">
              {nav.map((n) => <a href={n.href}>{n.label}</a>)}
              <a href={`tel:${SITE.telefonoE164}`}>Llamar al {SITE.telefono}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer dark">
      <div class="wrap foot">
        <div class="foot-brand">
          <Image src={logoBlanco} alt={SITE.nombre} width={160} />
          <p>
            Empresa constructora de {SITE.ciudad}. Ampliaciones, viviendas y módulos habitacionales en Steel Frame. {anios} años y más
            de {SITE.obrasTerminadas} obras terminadas.
          </p>
        </div>
        <div>
          <h2 class="foot-title">Servicios</h2>
          <ul>
            <li><a href="/ampliaciones">Ampliaciones de viviendas</a></li>
            <li><a href="/ampliaciones#planta-alta">Ampliación en planta alta</a></li>
            <li><a href="/modulos">Módulos habitacionales</a></li>
            <li><a href="/covacha">Covacha y Covacha Mini</a></li>
          </ul>
        </div>
        <div>
          <h2 class="foot-title">Contacto</h2>
          <ul>
            <li><a href={waLink()} target="_blank" rel="noopener">WhatsApp {SITE.whatsappTexto}</a></li>
            <li><a href={`tel:${SITE.telefonoE164}`}>Teléfono {SITE.telefono}</a></li>
            {SITE.email && <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>}
            <li>{SITE.zona}</li>
            {SITE.redes.instagram && <li><a href={SITE.redes.instagram} rel="me noopener" target="_blank">Instagram</a></li>}
            {SITE.redes.facebook && <li><a href={SITE.redes.facebook} rel="me noopener" target="_blank">Facebook</a></li>}
          </ul>
        </div>
      </div>
      <div class="wrap legal">
        <span>© {new Date().getFullYear()} {SITE.nombre} {SITE.bajada}. {SITE.ciudad}, Argentina.</span>
        <span>Las imágenes de proyectos son representaciones ilustrativas.</span>
      </div>
    </footer>

    <a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
      <Icon name="whatsapp" size={28} />
    </a>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 8px;
    z-index: 100;
    background: var(--ink);
    color: #fff;
    padding: 10px 14px;
    border-radius: 8px;
  }
  .skip:focus {
    left: 8px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(247 245 241 / 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 72px;
  }
  .brand img {
    width: 118px;
    height: auto;
  }
  .nav-desktop {
    display: flex;
    gap: 26px;
    margin-left: auto;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .nav-desktop a {
    text-decoration: none;
    color: var(--muted);
    padding-block: 6px;
    border-bottom: 2px solid transparent;
  }
  .nav-desktop a:hover,
  .nav-desktop a[aria-current="page"] {
    color: var(--ink);
    border-color: var(--accent);
  }
  .bar-cta {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .tel {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .btn-sm {
    min-height: 42px;
    padding: 0 18px;
    font-size: 0.95rem;
  }
  .nav-mobile {
    display: none;
    position: relative;
  }
  .nav-mobile summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--line);
    cursor: pointer;
  }
  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }
  .nav-mobile nav {
    position: absolute;
    right: 0;
    top: 52px;
    display: grid;
    min-width: 230px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.12);
  }
  .nav-mobile nav a {
    padding: 12px 14px;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 500;
  }
  .nav-mobile nav a:hover {
    background: var(--stone);
  }
  @media (max-width: 1060px) {
    .nav-desktop {
      display: none;
    }
    .bar-cta {
      margin-left: auto;
    }
    .nav-mobile {
      display: block;
    }
  }
  @media (max-width: 560px) {
    .tel {
      display: none;
    }
    .brand img {
      width: 96px;
    }
  }

  .site-footer {
    padding-block: 64px 28px;
  }
  .foot {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
  }
  .foot-brand {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .foot-brand p {
    color: #b9b2a9;
    max-width: 40ch;
    font-size: 0.95rem;
  }
  .foot-title {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9d968d;
    margin-bottom: 14px;
  }
  .foot ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 0.97rem;
  }
  .foot a {
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--accent);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid #34312d;
    font-size: 0.82rem;
    color: #8f887f;
  }
  @media (max-width: 760px) {
    .foot {
      grid-template-columns: 1fr;
    }
  }

  .wa-float {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #1fa855;
    color: #fff;
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.25);
    transition: transform 0.15s;
  }
  .wa-float:hover {
    transform: scale(1.06);
  }
</style>
