---
import Base from "../layouts/Base.astro";
import { waLink } from "../site";
---

<Base title="Página no encontrada · Hogacor" description="La página que buscás no existe." noindex>
  <section>
    <div class="wrap nf">
      <span class="eyebrow">Error 404</span>
      <h1>Esta página no existe</h1>
      <p class="lead">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      <div class="cta">
        <a class="btn btn-dark" href="/">Ir al inicio</a>
        <a class="btn btn-ghost" href={waLink()} target="_blank" rel="noopener">Escribinos por WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 18px;
    justify-items: start;
    min-height: 50vh;
    align-content: center;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
